#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/buaa-login/campus-login.sh --watch
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 20
    # No respawn: do not bypass the five-failure stop condition.
    procd_close_instance
}
